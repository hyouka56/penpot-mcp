FROM node:24-bookworm-slim

RUN corepack enable && corepack prepare pnpm@12.15.0 --activate

WORKDIR /app
COPY mcp/ ./mcp/
COPY plugins/libs/plugin-types/ ./plugins/libs/plugin-types/

WORKDIR /app/mcp

# Keep the official server's full tool inventory available in this hosted build.
# Developer-oriented tools may still need a Penpot dev REPL or local filesystem context.
RUN sed -i 's/if (this.isFileSystemAccessEnabled()) {/if (this.isFileSystemAccessEnabled() || process.env.ALL_TOOLS === "1") {/' packages/server/src/PenpotMcpServer.ts \
 && sed -i 's/if (shouldRegisterDeveloperTools(this.isDevEnv(), this.isMultiUserMode())) {/if (shouldRegisterDeveloperTools(this.isDevEnv(), this.isMultiUserMode()) || process.env.ALL_TOOLS === "1") {/' packages/server/src/PenpotMcpServer.ts \
 && pnpm install --frozen-lockfile \
 && pnpm run build

ENV NODE_ENV=production
ENV PENPOT_MCP_SERVER_HOST=127.0.0.1
ENV PENPOT_MCP_SERVER_PORT=4401
ENV PENPOT_MCP_WEBSOCKET_PORT=4402
ENV PENPOT_MCP_REMOTE_MODE=true
ENV PENPOT_MCP_DEVENV=true
ENV ALL_TOOLS=1

EXPOSE 3000
CMD ["node", "vercel-proxy.mjs"]